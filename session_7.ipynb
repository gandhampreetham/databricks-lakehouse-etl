    "# Cell 0: Emergency Workspace Table Initializer\n",
    "from pyspark.sql import functions as F\n",
    "print(\"--- Registering silver_orders into current workspace session ---\")\n",
    "# Build a local mock Silver dataset matching our Session 5 output\n",
    "mock_silver_records = [\n",
    "    (\"ORD_99\", \"CUST_A\", 100.00, \"Unknown\"),\n",
    "    (\"ORD_100\", \"CUST_B\", 250.00, \"Completed\"),\n",
    "    (\"ORD_101\", \"CUST_C\", 45.00, \"Completed\")\n",
    "]\n",
    "schema = [\"order_id\", \"customer_id\", \"amount\", \"status\"]\n",
    "silver_df = spark.createDataFrame(mock_silver_records, schema)\n",
    "# Register it permanently as a formal catalog table database object\n",
    "spark.sql(\"CREATE DATABASE IF NOT EXISTS demo_project_db\")\n",
    "silver_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"demo_project_db.silver_orders\")\n",
    "print(\"✅ Done! Table demo_project_db.silver_orders is now fully defined and ready.\")"
   ]
