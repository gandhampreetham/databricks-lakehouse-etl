    "# All-in-One Validation & Update Check for Session 6 from pyspark.sql import functions as F # 1. Ensure the database and mirror table exist locally for our validation test spark.sql(\"CREATE DATABASE IF NOT EXISTS demo_project_db\") clean_silver_df = spark.sql(\"SELECT order_id, customer_id, amount, status FROM demo_project_db.silver_orders\") clean_silver_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"demo_project_db.snowflake_target_mirror\") # 2. Run the Row Count Audit source_row_count = spark.table(\"demo_project_db.silver_orders\").count() target_row_count = spark.table(\"demo_project_db.snowflake_target_mirror\").count() print(f\"Source Table Count: {source_row_count} rows\") print(f\"Target Mirror Count: {target_row_count} rows\") if source_row_count == target_row_count: print(\"✅ [COUNT AUDIT PASSED]: 100% of records verified!\\n\")\n",
    "# 3. Simulate Next-Day Incremental Upsert (MERGE) new_daily_updates = [ (\"ORD_99\", \"CUST_A\", 150.00, \"Completed\"), (\"ORD_102\", \"CUST_D\", 320.00, \"Pending\") ] updates_df = spark.createDataFrame(new_daily_updates, [\"order_id\", \"customer_id\", \"amount\", \"status\"]) updates_df.createOrReplaceTempView(\"daily_snowflake_updates\") spark.sql(\"\"\" MERGE INTO demo_project_db.snowflake_target_mirror AS target USING daily_snowflake_updates AS source ON target.order_id = source.order_id WHEN MATCHED THEN UPDATE SET target.amount = source.amount, target.status = source.status WHEN NOT MATCHED THEN INSERT  \"\"\") # 4. Print the final 4 rows in plain text so output cannot be hidden print(\"--- Final Updated Target Warehouse Table ---\") spark.sql(\"SELECT  FROM demo_project_db.snowflake_target_mirror ORDER BY order_id\").show()"
   ]
