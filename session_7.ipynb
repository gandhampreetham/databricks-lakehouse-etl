   "source": [
    "# Complete All-in-One Session 6 Load & Validation Script\n",
    "from pyspark.sql import functions as F\n",
    "# Step 1: Clean slate setup so old table columns never interfere\n",
    "spark.sql(\"CREATE DATABASE IF NOT EXISTS demo_project_db\")\n",
    "spark.sql(\"DROP TABLE IF EXISTS demo_project_db.silver_orders\")\n",
    "spark.sql(\"DROP TABLE IF EXISTS demo_project_db.snowflake_target_mirror\")\n",
    "mock_silver_records = [\n",
    "    (\"ORD_99\", \"CUST_A\", 100.00, \"Unknown\"),\n",
    "    (\"ORD_100\", \"CUST_B\", 250.00, \"Completed\"),\n",
    "    (\"ORD_101\", \"CUST_C\", 45.00, \"Completed\")\n",
    "]\n",
    "silver_df = spark.createDataFrame(mock_silver_records, [\"order_id\", \"customer_id\", \"amount\", \"status\"])\n",
    "silver_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"demo_project_db.silver_orders\")\n",
    "# Step 2: Load the clean Silver data into our Snowflake Target Mirror table\n",
    "clean_silver_df = spark.table(\"demo_project_db.silver_orders\")\n",
    "clean_silver_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"demo_project_db.snowflake_target_mirror\")\n",
    "print(\"Step 1 & 2 Complete: Data loaded into Snowflake Target Mirror.\")\n",
    "# Step 3: Run the Row Count Audit (Verify 3 rows in source == 3 rows in target)\n",
    "source_count = spark.table(\"demo_project_db.silver_orders\").count()\n",
    "target_count = spark.table(\"demo_project_db.snowflake_target_mirror\").count()\n",
    "print(f\"Source Row Count: {source_count}\")\n",
    "print(f\"Target Row Count: {target_count}\")\n",
    "if source_count == target_count:\n",
    "    print(\"COUNT AUDIT PASSED: 100% of records transferred safely!\")\n",
    "# Step 4: Simulate next-day incremental updates using MERGE (Upsert)\n",
    "daily_updates = [\n",
    "    (\"ORD_99\", \"CUST_A\", 150.00, \"Completed\"),  # Updates ORD_99 amount from 100 to 150\n",
    "    (\"ORD_102\", \"CUST_D\", 320.00, \"Pending\")    # Inserts brand-new order ORD_102\n",
    "]\n",
    "updates_df = spark.createDataFrame(daily_updates, [\"order_id\", \"customer_id\", \"amount\", \"status\"])\n",
    "updates_df.createOrReplaceTempView(\"daily_snowflake_updates\")\n",
    "spark.sql(\"\"\"\n",
    "    MERGE INTO demo_project_db.snowflake_target_mirror AS target\n",
    "    USING daily_snowflake_updates AS source\n",
    "    ON target.order_id = source.order_id\n",
    "    WHEN MATCHED THEN\n",
    "        UPDATE SET target.amount = source.amount, target.status = source.status\n",
    "    WHEN NOT MATCHED THEN\n",
    "        INSERT (order_id, customer_id, amount, status) VALUES (source.order_id, source.customer_id, source.amount, source.status)\n",
    "\"\"\")\n",
    "print(\"Step 4 Complete: Incremental MERGE update finished.\")\n",
    "# Step 5: Print the final 4 updated rows in plain text so they are always visible\n",
    "print(\"\\n--- Final Target Warehouse Table (4 Rows) ---\")\n",
    "spark.sql(\"SELECT * FROM demo_project_db.snowflake_target_mirror ORDER BY order_id\").show()"
   ]
